{
  "hooks": {
    "UserPromptSubmit": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/dopamine-open.sh",
            "timeout": 15,
            "statusMessage": "YouTube を開いています..."
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/dopamine-close.sh",
            "timeout": 15,
            "statusMessage": "元の画面に戻しています..."
          }
        ]
      }
    ]
  }
}
